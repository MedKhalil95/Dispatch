<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Run on whatever .NET major version is actually installed (e.g. 9.x)
         instead of requiring an exact .NET 8 runtime alongside it. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Templates/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Static/css/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Static/img/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Static/js/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Static/ts is source-only (compiled via `npm run build`), never served -->
  </ItemGroup>

</Project>
